# PetMate environment
#
# Copy to .env and fill in. Everything here has a safe default for local
# development except the database URL, so `cp .env.example .env && npm run
# db:push && npm run db:seed` is enough to get running.
#
# The variables are validated by src/lib/env.ts at boot. Production additionally
# refuses to start on insecure defaults — see assertProductionSafety().

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Namespaced deliberately: a machine-level DATABASE_URL belonging to another
# project would otherwise shadow this one and point the app at the wrong data.
#
# Development (zero infrastructure):
PETMATE_DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL). Generate the schema with `npm run pg:schema` first.
# PETMATE_DATABASE_URL="postgresql://user:password@host:5432/petmate?schema=public"
#
# Only needed when the connection above goes through a pooler: migrations need
# a direct connection. Set it to the same value when there is no pooler.
# PETMATE_DIRECT_URL="postgresql://user:password@host:5432/petmate?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PetMate"
APP_URL="http://localhost:3000"

# The one currency this deployment trades in. Every price, balance and ledger
# account uses it. Choose it before launch: the ledger keeps balances per
# currency, so changing it later strands existing balances in the old one.
NEXT_PUBLIC_CURRENCY="EGP"

# Every date and time is shown in this zone, whatever the server runs in.
NEXT_PUBLIC_APP_TIMEZONE="Africa/Cairo"

# Signs CSRF tokens and every other keyed HMAC. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production will not start while this is the development default.
AUTH_SECRET="dev-only-insecure-secret-change-me-0123456789abcdef"

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# "ledger" settles through the internal double-entry ledger with a clearly
# labelled sandbox confirmation screen. Escrow, commission, refunds and payouts
# are the real implementation either way — only the card gateway is simulated.
# Production refuses to start on "ledger".
#
# "paymob" is the gateway for Egypt: cards, mobile wallets (Vodafone Cash and
# the rest), kiosk and instalments, through Paymob's hosted Unified Checkout.
# Stripe does not accept businesses registered in Egypt.
PAYMENT_PROVIDER="ledger"

# Paymob dashboard → Settings → API Keys (secret, public, HMAC) and
# Settings → Payment Integrations (one integration ID per payment method).
# Set the Transaction processed callback to https://<your-domain>/api/webhooks/paymob
# PAYMOB_SECRET_KEY="egy_sk_live_..."
# PAYMOB_PUBLIC_KEY="egy_pk_live_..."
# PAYMOB_HMAC_SECRET="..."
# PAYMOB_INTEGRATION_IDS="1234567,1234568"
# PAYMOB_BASE_URL="https://accept.paymob.com"

# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# "outbox" writes to the EmailMessage table and renders every message at
# /dev/mailbox. It does not deliver, so production refuses to start with it.
EMAIL_PROVIDER="outbox"
EMAIL_FROM="PetMate <no-reply@petmate.app>"
# RESEND_API_KEY="re_..."

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# With no key, every AI surface falls back to its deterministic path and says
# so in the interface. Nothing is ever presented as AI output when it is not.
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-opus-5"
AI_ENABLED="true"

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# "local" writes to ./public/uploads. Fine for development, not for more than
# one server — use s3 in production.
STORAGE_DRIVER="local"
# S3_BUCKET="petmate-uploads"
# S3_REGION="eu-west-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL="https://cdn.example.com"

# ---------------------------------------------------------------------------
# Operational
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
LOG_LEVEL="info"

# Runs the background worker in-process. Set false when running `npm run
# worker` as its own process, which is what production should do.
WORKER_ENABLED="true"

# Shared secret for POST /api/cron/tick, for platforms with no long-running
# process. Leave unset when a real worker runs.
# CRON_SECRET=""

# Seeds demo accounts and listings. Production refuses to start with this on.
SEED_DEMO_DATA="true"
