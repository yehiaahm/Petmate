{
  "name": "petmate",
  "version": "1.0.0",
  "private": true,
  "description": "PetMate أ¢â‚¬â€‌ the operating system for pet ownership.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "recompute": "tsx --conditions=react-server scripts/recompute.ts",
    "audit:ledger": "tsx scripts/audit-ledger.ts",
    "outbox": "tsx scripts/outbox.ts",
    "pg:schema": "tsx scripts/make-postgres-schema.ts",
    "worker": "tsx --conditions=react-server src/worker/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "prisma": {
    "seed": "tsx --conditions=react-server prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.716.0"
  }
}
